# URL-encode special characters in the database password.
DATABASE_URL=mysql://locat:replace-with-your-password@127.0.0.1:3306/locat
PORT=3000
HOST=127.0.0.1
# Production access should use HTTPS through Tailscale Serve or Caddy.
COOKIE_SECURE=true

# Optional strict browser origin check, required if a proxy changes the Host header.
# Use your actual HTTPS address without a trailing slash.
# PUBLIC_ORIGIN=https://your-pi.your-tailnet.ts.net

# Optional Web Push. Generate once with npm run push:setup -- mailto:YOUR_EMAIL
# VAPID_SUBJECT=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
